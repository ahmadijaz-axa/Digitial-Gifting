<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/collapsed"
        motion:constraintSetStart="@id/expanded"
        motion:duration="1000">
        <!--        motion:motionInterpolator="linear"-->
        <KeyFrameSet></KeyFrameSet>

        <OnSwipe
            motion:dragDirection="dragUp"
            motion:touchAnchorId="@id/nav_market_place_container"
            motion:touchAnchorSide="top" />

    </Transition>

    <ConstraintSet
        android:id="@+id/expanded"
        android:alpha="1">

<!--        motion:visibilityMode="ignore"-->
        <Constraint
            android:id="@+id/topToolBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />

        <Constraint
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/sdp_40"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintStart_toStartOf="@+id/topToolBar"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/tv_jazzcash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintEnd_toEndOf="@+id/topToolBar"
            motion:layout_constraintStart_toStartOf="@+id/topToolBar"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/iv_user_profile"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/sdp_40"
            android:layout_marginEnd="@dimen/figma_16_dp"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintEnd_toStartOf="@+id/iv_search"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/iv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/figma_16_dp"
            android:visibility="gone"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/figma_48_dp"
            motion:layout_constrainedWidth="true"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/searchRecipientET"
            android:layout_width="0dp"
            android:layout_height="@dimen/figma_48_dp"
            android:layout_marginStart="@dimen/figma_16_dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/figma_10_sp"
            android:layout_marginBottom="@dimen/figma_16_dp"
            motion:layout_constrainedWidth="true"
            motion:layout_constraintBottom_toBottomOf="@+id/searchBar"
            motion:layout_constraintEnd_toStartOf="@+id/cart_ic"
            motion:layout_constraintStart_toStartOf="@+id/searchBar"
            motion:layout_constraintTop_toTopOf="@+id/searchBar" />
        <Constraint
            android:id="@+id/cart_ic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/figma_16_dp"
            android:layout_marginEnd="@dimen/figma_16_dp"
            android:layout_marginBottom="@dimen/figma_16_dp"
            motion:layout_constraintBottom_toBottomOf="@+id/searchBar"
            motion:layout_constraintEnd_toEndOf="@+id/searchBar"
            motion:layout_constraintTop_toTopOf="@+id/searchBar" />
        <Constraint

            android:id="@+id/totalItemCount"
            android:layout_width="11dp"
            android:layout_height="12dp"
            android:layout_marginEnd="@dimen/figma_1_dp"
            motion:visibilityMode="ignore"
            motion:layout_constraintEnd_toEndOf="@+id/cart_ic"
            motion:layout_constraintTop_toTopOf="@+id/cart_ic"
            motion:layout_editor_absoluteX="383dp" />
        <Constraint
            android:id="@+id/nav_market_place_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            motion:layout_constrainedHeight="true"
            motion:layout_constrainedWidth="true"
            android:layout_marginTop="@dimen/figma_17_dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/searchBar" />
    </ConstraintSet>


    <ConstraintSet android:id="@+id/collapsed">


        <Constraint
            android:id="@+id/topToolBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/sdp_40"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintStart_toStartOf="@+id/topToolBar"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/tv_jazzcash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:visibility="invisible"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintEnd_toStartOf="@+id/iv_user_profile"
            motion:layout_constraintStart_toEndOf="@+id/iv_back"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/iv_user_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/figma_16_dp"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintEnd_toStartOf="@+id/iv_search"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/iv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/figma_16_dp"
            android:visibility="visible"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintEnd_toStartOf="@id/cart_ic"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />


        <Constraint
            android:id="@+id/cart_ic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/figma_16_dp"
            android:layout_marginEnd="@dimen/figma_16_dp"
            motion:layout_constraintBottom_toBottomOf="@+id/topToolBar"
            motion:layout_constraintEnd_toEndOf="@id/topToolBar"
            motion:layout_constraintTop_toTopOf="@+id/topToolBar" />


        <Constraint
            android:id="@+id/totalItemCount"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/figma_1_dp"
            motion:visibilityMode="ignore"
            motion:layout_constraintEnd_toEndOf="@+id/cart_ic"
            motion:layout_constraintTop_toTopOf="@+id/cart_ic" />


        <Constraint
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:visibility="gone"
            motion:layout_constrainedWidth="true"
            motion:layout_constraintTop_toBottomOf="@+id/topToolBar" />
        <Constraint
            android:id="@+id/searchRecipientET"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/figma_16_dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/figma_10_sp"
            android:layout_marginBottom="@dimen/figma_16_dp"
            android:visibility="gone"
            motion:layout_constrainedWidth="true"
            motion:layout_constraintBottom_toBottomOf="@+id/searchBar"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="@+id/searchBar"
            motion:layout_constraintTop_toTopOf="@+id/searchBar" />


        <Constraint
            android:id="@+id/nav_market_place_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            motion:layout_constrainedHeight="true"
            motion:layout_constrainedWidth="true"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/searchBar" />


    </ConstraintSet>


</MotionScene>