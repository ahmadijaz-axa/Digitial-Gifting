<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected State -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#000000"/> <!-- Black background when selected -->
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#000000"/> <!-- Black border -->
        </shape>
    </item>

    <!-- Default (Unselected) State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/> <!-- Light gray background -->
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#E0E0E0"/> <!-- Light gray border -->
        </shape>
    </item>
</selector>