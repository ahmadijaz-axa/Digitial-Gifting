<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.digitalgifting.fragment.DigitalGiftOptionFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="A little love has arrived!"
            android:fontFamily="@font/worksans_semibold"
            android:textColor="@color/darkBlack"
            android:textSize="@dimen/figma_20_sp"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/figma_20_dp"
            android:layout_marginHorizontal="@dimen/figma_35_dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_sub_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Say hi!"
            android:fontFamily="@font/worksans_regular"
            android:textColor="@color/lightBlack"
            android:textSize="@dimen/figma_16_sp"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/figma_5_dp"
            android:layout_marginHorizontal="@dimen/figma_35_dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/figma_20_dp"
            android:layout_marginHorizontal="@dimen/figma_16_dp"
            app:layout_constraintTop_toBottomOf="@id/tv_sub_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/figma_4_dp"
                android:layout_marginEnd="@dimen/figma_4_dp"
                android:layout_marginBottom="@dimen/_100sdp"
                android:background="@drawable/gray_bg_eidi"
                android:elevation="2dp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_envelope_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/envelope_top"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toTopOf="@id/img_envelope"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_envelope"
                android:layout_width="0dp"
                android:layout_height="@dimen/_230sdp"
                app:srcCompat="@drawable/envelope"
                android:scaleType="fitXY"
                android:elevation="@dimen/figma_5_dp"
                android:layout_marginBottom="@dimen/figma_34_dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lyt_send_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/figma_26_dp"
                android:layout_marginTop="@dimen/figma_24_dp"
                android:layout_marginEnd="@dimen/figma_26_dp"
                android:background="@drawable/gray_border_white_bg"
                android:elevation="@dimen/figma_6_dp"
                android:paddingBottom="@dimen/figma_16_dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/figma_16_dp"
                    android:layout_marginTop="@dimen/figma_16_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_stars" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_send_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/figma_12_dp"
                    android:gravity="center"
                    android:text="@string/send_now"
                    android:fontFamily="@font/worksans_semibold"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/figma_16_sp"
                    app:layout_constraintStart_toStartOf="@id/img_stars"
                    app:layout_constraintTop_toBottomOf="@id/img_stars" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_send_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/wrap_your_wish"
                    android:textSize="@dimen/figma_12_sp"
                    android:fontFamily="@font/worksans_regular"
                    android:textColor="@color/grey_393939"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/img_stars"
                    app:layout_constraintTop_toBottomOf="@id/tv_send_now" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_send_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/figma_16_dp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_send_now"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:srcCompat="@drawable/arrow_right_24dp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_track"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/figma_16_dp"
                    android:background="@drawable/redeem_eidi_bg"
                    android:gravity="start"
                    android:paddingStart="@dimen/figma_8_dp"
                    android:paddingTop="@dimen/figma_4_dp"
                    android:paddingEnd="@dimen/figma_8_dp"
                    android:paddingBottom="@dimen/figma_4_dp"
                    android:text="@string/add_new_payer_track"
                    android:textColor="@color/grey_393939"
                    android:fontFamily="@font/worksans_semibold"
                    android:textSize="@dimen/figma_12_sp"
                    app:layout_constraintBottom_toBottomOf="@id/img_stars"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/img_stars" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lyt_redeem_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/figma_26_dp"
                android:layout_marginTop="@dimen/figma_24_dp"
                android:layout_marginEnd="@dimen/figma_26_dp"
                android:background="@drawable/gray_border_white_bg"
                android:elevation="@dimen/figma_6_dp"
                app:layout_constraintTop_toBottomOf="@id/lyt_send_now"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:paddingBottom="@dimen/figma_16_dp"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_redeem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/figma_14_dp"
                    android:layout_marginTop="@dimen/figma_14_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_redeem" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_redeem_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/figma_16_dp"
                    android:gravity="center"
                    android:text="@string/redeem_now"
                    android:fontFamily="@font/worksans_semibold"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/figma_16_sp"
                    app:layout_constraintStart_toStartOf="@id/img_redeem"
                    app:layout_constraintTop_toBottomOf="@id/img_redeem" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_redeem_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/see_your_gift_here"
                    android:textSize="@dimen/figma_12_sp"
                    android:fontFamily="@font/worksans_regular"
                    android:textColor="@color/grey_393939"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/img_redeem"
                    app:layout_constraintTop_toBottomOf="@id/tv_redeem_now" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_redeem_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/figma_16_dp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_redeem_now"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:srcCompat="@drawable/arrow_right_24dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>