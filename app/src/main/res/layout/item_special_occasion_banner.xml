<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/figma_95_dp"
    android:layout_marginHorizontal="@dimen/figma_18_dp"
    app:cardCornerRadius="@dimen/figma_8_dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/figma_72_dp"
            android:layout_height="@dimen/figma_72_dp"
            android:layout_marginStart="@dimen/figma_12_dp"
            android:contentDescription="icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/figma_12_dp"
            android:text="@string/speidi"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/figma_14_sp"
            style="@style/Bold1024Black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivIcon"
            app:layout_constraintTop_toTopOf="@id/ivIcon"
            app:layout_constraintVertical_bias="0.19" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wishing You very Happy Eid!"
            android:textColor="@color/grey_universal"
            android:textSize="@dimen/figma_12_sp"
            style="@style/regular1220darkBlack"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvDaysLeft"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_days_badge"
            android:text="8 Days"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView> 