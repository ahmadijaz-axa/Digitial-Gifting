<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".view.digitalgifting.fragment.DigitalGiftingDashboardFragment">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/appCompatTextView7"
            style="@style/Medium1416DarkBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/figma_16_dp"
            android:text="@string/special_occasions"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/figma_20_sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSpecialOccasionBanners"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/figma_16_dp"
            app:layout_constraintTop_toBottomOf="@id/appCompatTextView7" />

        <com.ibm.jazzcashconsumer.util.DotsIndicatorRound
            android:id="@+id/dotsIndicatorCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/rvSpecialOccasionBanners"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/figma_8_dp"
            app:dotsColor="@color/latestGrey"
            app:dot_height="@dimen/figma_7_dp"
            app:dot_width="@dimen/figma_7_dp"
            app:selected_dot_resource="@drawable/indicator_warning_red"
            app:progressMode="false"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEverydayOccasion"
            style="@style/Medium1416DarkBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/figma_16_dp"
            android:layout_marginStart="@dimen/figma_16_dp"
            android:text="@string/everyday_occasion"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/figma_20_sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dotsIndicatorCards" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEverydayOccasions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/figma_16_dp"
            android:layout_marginStart="@dimen/figma_8_dp"
            android:layout_marginEnd="@dimen/figma_16_dp"
            android:paddingBottom="@dimen/figma_32_dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/tvEverydayOccasion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>