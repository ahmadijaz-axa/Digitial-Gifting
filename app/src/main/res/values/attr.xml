<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MaxHeightScrollView">
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>
    <declare-styleable name="RipplePulseLayout">
        <attr name="rippleColor" format="color"></attr>
        <attr name="rippleType" format="enum">
            <enum name="fill" value="0"></enum>
            <enum name="stroke" value="1"></enum>
        </attr>
        <attr name="startRadius" format="dimension"></attr>
        <attr name="endRadius" format="dimension"></attr>
        <attr name="duration" format="integer"></attr>
        <attr name="strokeWidth" format="dimension"></attr>
    </declare-styleable>
    <declare-styleable name="TextView">
        <attr name="letterDuration" format="integer" />
    </declare-styleable>

    <declare-styleable name="CustomButtonView">
        <attr name="buttonIcon" format="reference" />
        <attr name="buttonTitle" format="string" />
        <attr name="titlePaddingStart" format="integer" />
        <attr name="iconPaddingStart" format="integer" />
        <attr name="titleColor" format="color" />
        <attr name="iconColor" format="color" />
        <attr name="titleTextSize" format="float" />
        <attr name="iconPaddingTop" format="integer" />

    </declare-styleable>
    <declare-styleable name="MaskEditText">
        <attr name="mask" format="string" />
        <attr name="placeholder" format="string" />
    </declare-styleable>

    <declare-styleable name="CustomDebitCardView">
        <attr name="backgroundDrawable" format="reference" />
        <attr name="backgroundColor" format="color" />
    </declare-styleable>

    <declare-styleable name="CarouselSliderWidget"/>

</resources>